# Telegram Bot Token (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key (Get from console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Your Telegram User ID (Get from @userinfobot to restrict access to ONLY you)
ALLOWED_USER_ID=123456789

# Optional persistent usage database location
# USAGE_DB_PATH=/absolute/path/to/groq_usage.sqlite3

# Optional: point the bot at a separately installed Local Telegram Bot API
# server to support downloads larger than the hosted API's 20 MB limit.
# TELEGRAM_LOCAL_MODE=true
# TELEGRAM_BASE_URL=http://127.0.0.1:8081/bot
# TELEGRAM_BASE_FILE_URL=http://127.0.0.1:8081/file/bot
# TELEGRAM_LOCAL_DATA_DIR=/var/lib/telegram-bot-api
